{
  "//": "Purity wall: the logic core compiles WITHOUT the DOM lib, so any accidental",
  "//2": "reference to document/window/canvas is a compile error. Run: npx tsc -p src/core",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [".", "../contract"]
}
